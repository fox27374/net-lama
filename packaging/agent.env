# Net-Lama agent configuration (read by systemd, one KEY=value per line).
# After editing: systemctl restart netlama-agent

# Enrollment token, shown once when the agent is created in the UI. Required.
NETLAMA_TOKEN=

# Server address (host:port), or "auto" to find it in DNS:
# SRV _netlama._tcp, then A net-lama, both in the local search domain.
NETLAMA_SERVER=auto

# Client ID for logging; defaults to the hostname.
#NETLAMA_CLIENT_ID=

# TLS for the control stream. Verify with NETLAMA_TLS_CA (a copy of the
# server cert), or set NETLAMA_TLS_INSECURE=1 to encrypt without verifying.
#NETLAMA_TLS=1
#NETLAMA_TLS_CA=/etc/netlama/server-ca.pem
#NETLAMA_TLS_INSECURE=

# mTLS client certificate, issued per agent by the server
# (`netlama-server -issue-agent-cert <agent-name>`).
#NETLAMA_TLS_CERT=/etc/netlama/agent.pem
#NETLAMA_TLS_KEY=/etc/netlama/agent.key

# Synthetic data instead of real probes, for testing without hardware.
#NETLAMA_WLAN_DEMO=1
#NETLAMA_TRACEROUTE_DEMO=1
