[Unit]
Description=Net-Lama monitoring agent
Documentation=https://github.com/fox27374/net-lama
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/netlama/agent.env
ExecStart=/usr/bin/netlama-agent
Restart=always
RestartSec=10s

# The probes shell out to mtr, iw, ip and wpa_supplicant: raw sockets for
# path tracing, interface control for WLAN sensing, and route/address
# changes for the active WLAN test. That needs root on the sensor host.
# An agent that only runs ping/dns/http/tcp/speedtest can run unprivileged
# instead — replace this block with:
#   User=netlama
#   AmbientCapabilities=CAP_NET_RAW
# (and create the user; unprivileged ICMP also needs net.ipv4.ping_group_range).
User=root
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
