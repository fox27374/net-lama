[Unit]
Description=Net-Lama monitoring agent
Documentation=https://github.com/fox27374/net-lama
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/netlama/agent.env
ExecStart=/usr/bin/netlama-agent
Restart=always
RestartSec=10s

# The WLAN probes shell out to iw, ip and wpa_supplicant: interface control
# for sensing, and route/address changes for the active WLAN test. That needs
# root on the sensor host. Path tracing does NOT — the native traceroute
# engine probes with ordinary sockets. An agent that only runs
# ping/dns/http/tcp/saas/speedtest/traceroute can run unprivileged instead —
# replace this block with:
#   User=netlama
#   AmbientCapabilities=CAP_NET_RAW
# (and create the user; unprivileged ICMP also needs net.ipv4.ping_group_range).
User=root
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
